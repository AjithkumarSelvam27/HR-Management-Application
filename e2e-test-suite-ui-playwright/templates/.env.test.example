# Copy to .env.test (gitignored) and fill in. This MUST be a DEDICATED test database,
# never the app's own one: every run DROPS all tables in it and re-creates schema + seed.
# mysql://user:password@host:port/dbname   (a different dbname than the one in server/.env)
E2E_DATABASE_URL=
# Optional overrides
# E2E_API_PORT=8100
# E2E_UI_PORT=4300
