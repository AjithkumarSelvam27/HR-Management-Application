{
  "name": "hrms-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run server:dev\" \"npm run --prefix client start\"",
    "server:dev": "cd server && uvicorn main:app --reload --port 8000",
    "build": "npm run --prefix client build",
    "start": "cd server && ENV=production uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "db:setup": "cd server && python -m db.migrate",
    "lint": "ruff check server --exclude server/venv",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report e2e-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.0.0",
    "dotenv": "^18.0.9",
    "mysql2": "^3.24.6"
  }
}
